# ============================================================================
# BOT PARK — Configurazione Variabili d'Ambiente (.env)
# Copia questo file in `.env` e inserisci le tue chiavi API
# ============================================================================

# Google Gemini API Key (per Chat & Chiamata Vocale Multimodal Audio)
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# ElevenLabs API Key (opzionale — per sintesi vocale neurale)
VITE_ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Indirizzo IP opzionale per il bridge ADB verso Android TV
VITE_ANDROID_TV_IP=192.168.1.100:5555
